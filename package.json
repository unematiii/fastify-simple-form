{
  "name": "fastify-simple-form",
  "version": "4.0.0",
  "description": "Fastify plugin that parses URL-encoded and multipart form fields",
  "main": "dist/index.js",
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint src test && tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unematiii/fastify-simple-form.git"
  },
  "keywords": [
    "fastify",
    "form-data",
    "multipart"
  ],
  "author": "Mati Kärner",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unematiii/fastify-simple-form/issues"
  },
  "homepage": "https://github.com/unematiii/fastify-simple-form#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "fastify": "^5.12.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "fastify": ">=4"
  },
  "dependencies": {
    "@types/busboy": "^1.5.5",
    "busboy": "^1.6.0",
    "fastify-plugin": "^6.0.1"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
